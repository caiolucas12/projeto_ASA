$TTL 604800
@   IN SOA arq.{{ dominio }}. admin.{{ dominio }}. (
        1       ; serial
        604800  ; refresh
        86400   ; retry
        2419200 ; expire
        604800 ) ; negative cache TTL
@   IN NS  arq.{{ dominio }}.
arq IN A   {{ ip_arq }}
db  IN A   {{ ip_db }}
app IN A   {{ ip_app }}
