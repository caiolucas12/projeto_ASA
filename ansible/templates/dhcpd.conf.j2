authoritative;
default-lease-time 180;
max-lease-time 3600;
option domain-name "{{ dominio }}";
option domain-name-servers {{ ip_arq }};

subnet 192.168.56.0 netmask 255.255.255.0 {
  range 192.168.56.50 192.168.56.100;
  option routers 192.168.56.1;
}

# Reserva do DB via MAC 08:00:27:00:00:02
host db {
  hardware ethernet 08:00:27:00:00:02;
  fixed-address {{ ip_db }};
}

# Reserva do App via MAC 08:00:27:00:00:03
host app {
  hardware ethernet 08:00:27:00:00:03;
  fixed-address {{ ip_app }};
}
